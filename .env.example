# Copy this file to .env and fill in real values. .env is gitignored.

# Optional: HuggingFace token. Not required for UniTalk-ASD (public dataset),
# but avoids anonymous rate limits on large downloads.
HF_TOKEN=

# Optional: override where data/ lives, e.g. a mount with more free space.
# Defaults to <project_root>/data if unset.
DATA_ROOT=

# Optional: folder to run scripts/extract_landmarks.py against directly, e.g.
# a train/val person folder or an arbitrary eval folder of images.
# Defaults to a sample train folder if unset.
EXTRACT_LANDMARKS_PERSON_DIR=
