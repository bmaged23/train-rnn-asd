# Copy this file to .env. Keep real credentials out of Git.

# Optional: Hugging Face token. Public datasets do not normally require it,
# but a token helps avoid anonymous Hub rate limits.
HF_TOKEN=

# Optional: absolute path for raw datasets, processed CSVs, and caches.
# Defaults to <project root>/data. Choose a disk with ample free space.
DATA_ROOT=

# Optional: Hugging Face model/cache location. The VLM weights require several GB.
# Defaults to ~/.cache/huggingface.
HF_HOME=

# Optional: folder for scripts/features/extract_landmarks.py ad-hoc extraction.
EXTRACT_LANDMARKS_PERSON_DIR=

# Per-pool CPU/download worker cap. Default: min(4, available CPUs minus one).
# Raise deliberately on a suitable server; this is not a total-process limit.
# ASD_WORKER_LIMIT=4
